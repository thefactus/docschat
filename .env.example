OPENAI_API_KEY=your-openai-api-key

# PostgreSQL — overridden by docker-compose for container-to-container
DATABASE_URL=postgresql://docschat:docschat@localhost:5432/docschat

# Optional overrides (all use OpenAI; swap generation_model to any chat model)
GENERATION_MODEL=gpt-4.1-mini
PLANNER_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
MAX_UPLOAD_MB=20

# Frontend — browser-side URL for the backend API
NEXT_PUBLIC_API_URL=http://localhost:8000
